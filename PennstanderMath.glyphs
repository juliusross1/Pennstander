sub xbolditalic-math from [xbolditalic-math xbolditalic-math.alt1 xbolditalic-math.alt2];

} letter_alternates;

#
# Symbols
#
lookup symbol_alternates {
sub plus from [plus plus.alt1];
sub minus from [minus minus.alt2];
sub equal from [equal equal.alt1 equal.alt2 equal.alt3];
sub summation from [summation summation.alt1 summation.alt2];
} symbol_alternates;

#
# Numerals
#

lookup numeral_alternates {
sub one from [one one.alt1 one.alt2 one.alt3];
sub two from [two two.alt1];
sub four.ss04 from [four.ss04 four.alt1.ss04 four.alt2.ss04];
sub five from [five five.alt1];
sub fivebold-math from [fivebold-math fivebold-math.alt1];
} numeral_alternates;
";
name = Alternates;
}
