sub nopoleLineIntegral from [nopoleLineIntegral nopoleLineIntegral.alt2 nopoleLineIntegral.alt3];
sub quadrupleIntegral from [quadrupleIntegral quadrupleIntegral.alt2 quadrupleIntegral.alt3];
sub volumeIntegral from [volumeIntegral volumeIntegral.alt2 volumeIntegral.alt3];
sub counterclockwisecontourIntegral from [counterclockwisecontourIntegral counterclockwisecontourIntegral.alt2 counterclockwisecontourIntegral.alt3];
