},
{
code = "script math;
language dflt;
lookup SUB_6 {
	sub i by idotless;
	sub j by jdotless;
	sub ibold-math by idotlessbold-math;
	sub jbold-math by jdotlessbold-math;
	sub iitalic-math by idotlessitalic-math;
	sub jitalic-math by jdotlessitalic-math;
	sub ibolditalic-math by idotlessbolditalic-math;
	sub jbolditalic-math by jdotlessbolditalic-math;
 	sub i-fraktur by i-frakturdotless;
	sub j-fraktur by j-frakturdotless;
	sub i-frakturbold-math by i-frakturdotlessbold-math;
	sub j-frakturbold-math by j-frakturdotlessbold-math;
} SUB_6;
";
tag = dtls;
},
{
automatic = 1;
code = "lookup ccmp_DFLT_1 {
	@CombiningTopAccents = [acutecomb brevecomb breveinvertedcomb candraBinducomb caroncomb circumflexcomb commaturnedabovecomb dblgravecomb dieresiscomb dotaccentcomb gravecomb hookabovecomb hungarumlautcomb macroncomb ringcomb tildecomb];
	lookupflag UseMarkFilteringSet @CombiningTopAccents;
	sub i' @CombiningTopAccents by idotless;
	sub j' @CombiningTopAccents by jdotless;
} ccmp_DFLT_1;

lookup ccmp_DFLT_2 {
	lookupflag 0;
	sub brevecomb acutecomb by brevecomb_acutecomb;
	sub brevecomb gravecomb by brevecomb_gravecomb;
	sub brevecomb hookabovecomb by brevecomb_hookabovecomb;
	sub brevecomb tildecomb by brevecomb_tildecomb;
	sub circumflexcomb gravecomb by circumflexcomb_gravecomb;
	sub circumflexcomb hookabovecomb by circumflexcomb_hookabovecomb;
	sub circumflexcomb tildecomb by circumflexcomb_tildecomb;
} ccmp_DFLT_2;

lookup ccmp_Other_1 {
	lookupflag 0;
	@Markscomb = [dieresiscomb dotaccentcomb gravecomb acutecomb hungarumlautcomb circumflexcomb caroncomb ringcomb tildecomb macroncomb dblgravecomb commaturnedabovecomb horncomb dotbelowcomb dieresisbelowcomb commaaccentcomb cedillacomb ogonekcomb macronbelowcomb brevecomb hookabovecomb breveinvertedcomb];
	@MarkscombCase = [dieresiscomb.case dotaccentcomb.case gravecomb.case acutecomb.case hungarumlautcomb.case circumflexcomb.case caroncomb.case ringcomb.case tildecomb.case macroncomb.case dblgravecomb.case commaturnedabovecomb.case horncomb.case dotbelowcomb.case dieresisbelowcomb.case commaaccentcomb.case cedillacomb.case ogonekcomb.case macronbelowcomb.case brevecomb.case hookabovecomb.case breveinvertedcomb.case];
	sub @Markscomb @Markscomb' by @MarkscombCase;
	sub @Uppercase @Markscomb' by @MarkscombCase;
} ccmp_Other_1;

lookup ccmp_Other_2 {
	lookupflag 0;
	sub @Markscomb' @MarkscombCase by @MarkscombCase;
	sub @MarkscombCase @Markscomb' by @MarkscombCase;
} ccmp_Other_2;
";
disabled = 1;
tag = ccmp;
},
{
automatic = 1;
code = "script latn;
