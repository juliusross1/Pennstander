sub rightwhitesquarebracket-math from [rightwhitesquarebracket-math rightwhitesquarebracket-math.alt1 rightwhitesquarebracket-math.alt2];
sub leftanglebracket-math from [leftanglebracket-math leftanglebracket-math.alt1];
sub rightanglebracket-math from [rightanglebracket-math rightanglebracket-math.alt1];
sub leftCeiling from [leftCeiling leftCeiling.alt1 leftCeiling.alt2];
sub rightCeiling from [rightCeiling rightCeiling.alt1 rightCeiling.alt2];
